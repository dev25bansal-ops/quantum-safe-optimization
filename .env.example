# =============================================================================
# Quantum-Safe Secure Optimization Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application (REQUIRED)
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
DEBUG=false

# -----------------------------------------------------------------------------
# Security (REQUIRED in production - generate unique values)
# -----------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
QSOP_SECRET_KEY=                       # REQUIRED in production - 32+ char secret
JWT_SECRET=                            # REQUIRED in production - JWT signing key
CSRF_SECRET=                           # REQUIRED in production - CSRF token signing key

# -----------------------------------------------------------------------------
# Post-Quantum Cryptography
# -----------------------------------------------------------------------------
PQC_KEY_PATH=./keys
PQC_KEY_MAX_AGE_DAYS=90
PQC_KEY_ROTATE_BEFORE_DAYS=7
PQC_KEM_ALGORITHM=Kyber768             # Kyber512 | Kyber768 | Kyber1024
PQC_SIG_ALGORITHM=Dilithium3           # Dilithium2 | Dilithium3 | Dilithium5

# -----------------------------------------------------------------------------
# Database - Azure Cosmos DB
# -----------------------------------------------------------------------------
COSMOS_ENDPOINT=https://localhost:8081  # Local emulator or Azure endpoint
COSMOS_KEY=                             # REQUIRED - Cosmos DB key (emulator key for local dev)
COSMOS_DATABASE=quantum_optimization
USE_MANAGED_IDENTITY=false             # true for Azure production with managed identity

# -----------------------------------------------------------------------------
# Database - PostgreSQL (alternative to Cosmos DB)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qsop

# -----------------------------------------------------------------------------
# Redis (REQUIRED for caching, rate limiting, and session management)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Quantum Backends (at least one required for real quantum execution)
# -----------------------------------------------------------------------------
# IBM Quantum
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=ibm-q/open/main

# AWS Braket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BRAKET_S3_BUCKET=

# Azure Quantum
AZURE_QUANTUM_SUBSCRIPTION_ID=
AZURE_QUANTUM_RESOURCE_GROUP=
AZURE_QUANTUM_WORKSPACE=
AZURE_QUANTUM_LOCATION=eastus

# D-Wave
DWAVE_API_TOKEN=
DWAVE_SOLVER=Advantage_system6.4

# Local simulator (default - no credentials needed)
QUANTUM_BACKEND=aer_simulator          # aer_simulator | ibm_quantum | aws_braket | dwave

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# -----------------------------------------------------------------------------
# Celery (REQUIRED for production job processing)
# -----------------------------------------------------------------------------
USE_CELERY=false                       # true for production
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=quantum-api
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_CONSOLE_EXPORT=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_BACKUP_ENABLED=true

# -----------------------------------------------------------------------------
# Demo Mode (development only - BLOCKED in production)
# -----------------------------------------------------------------------------
DEMO_MODE=false
ENABLE_AUDIT_LOGGING=true
ENABLE_REQUEST_SIGNING=false
ENABLE_CSRF_PROTECTION=true

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_WORKERS=4

# -----------------------------------------------------------------------------
# Admin (optional)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Grafana (docker-compose)
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose - uncomment if using)
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD=qsop_password
